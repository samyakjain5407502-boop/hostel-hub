# ------------------------------------------------------------------
# HostelHub · Environment (copy to .env.local for local development)
# Demo works out-of-the-box in "mock" mode. Set NEXT_PUBLIC_DATA_MODE=supabase
# to opt into a live Supabase/PostgreSQL backend and fill the keys below.
# ------------------------------------------------------------------

# Data layer: "mock" (zero-config demo, caches to localStorage) | "supabase"
NEXT_PUBLIC_DATA_MODE=mock

# Secret used to sign demo session tokens (JWT-like, HS256). Rotate in prod.
AUTH_SECRET=hostelhub_demo_signing_secret_change_me

# ------------------------------------------------------------------
# Supabase (only required when NEXT_PUBLIC_DATA_MODE=supabase)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prisma direct database url (optional, for `prisma migrate`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hostelhub

# ------------------------------------------------------------------
# SMS / OTP gateway (only used when NEXT_PUBLIC_DATA_MODE=supabase)
# Pick one provider and wire it into src/lib/otp.ts → deliverOtp()
# and your POST /api/otp/send route handler. In mock mode the freshly
# generated OTP is shown on screen instead of being texted.
# ------------------------------------------------------------------
# Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Fast2SMS (India)
# FAST2SMS_API_KEY=your-fast2sms-key
# Firebase Auth (client SDK owns the challenge)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Institutional contact (shown in footer)
NEXT_PUBLIC_CONTACT_EMAIL=Samyakthora@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+91 9098088466
NEXT_PUBLIC_INSTITUTE=Medi-Caps University | Cause '26