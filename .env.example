# ------------------------------------------------------------------
# HostelHub · Environment (copy to .env.local for local development)
# Demo works out-of-the-box in "demo" mode. Set NEXT_PUBLIC_DATA_MODE=supabase
# to opt into a live Supabase/PostgreSQL backend and fill the keys below.
# ------------------------------------------------------------------

# Data layer (Phase 5):
#   demo     → zero-config demo: seed data + localStorage (`mock` is kept as a
#              legacy alias and behaves identically)
#   supabase → live Supabase/Postgres; the Supabase + SMS vars below are required
NEXT_PUBLIC_DATA_MODE=demo

# Secret used to sign demo session tokens (JWT-like, HS256). Rotate in prod.
# Generate a strong one with:
#   openssl rand -base64 32
#   (PowerShell equivalent: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#   — or simply `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
# Required whenever NEXT_PUBLIC_DATA_MODE=supabase: startup fails loudly rather
# than signing sessions with the public demo secret.
AUTH_SECRET=hostelhub_demo_signing_secret_change_me

# ------------------------------------------------------------------
# Supabase (only required when NEXT_PUBLIC_DATA_MODE=supabase)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (server-only — NEVER prefix with NEXT_PUBLIC_).
# Powers the app-session → profiles.role bridge (POST /api/profile/sync)
# and scripts/seed-supabase.ts. Optional: without it role sync is skipped
# and staff RLS writes stay denied in live mode (mock mode unaffected).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma direct database url (optional, for `prisma migrate`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hostelhub

# ------------------------------------------------------------------
# SMS / OTP gateway (only used when NEXT_PUBLIC_DATA_MODE=supabase)
# Wired in src/lib/sms.ts and used by POST /api/otp/send. Pick ONE provider
# and set its keys — the sender auto-detects whichever is complete.
# If none are set, /api/otp/send answers 503 `sms_not_configured` (naming
# the missing vars) instead of crashing. Mock mode never texts anything:
# the freshly generated OTP is shown on screen instead.
# ------------------------------------------------------------------
# Optional: force a provider when both are configured ('twilio' | 'fast2sms')
# SMS_PROVIDER=fast2sms
# Twilio (international)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Fast2SMS (India — route 'otp', requires a DLT-approved template)
# FAST2SMS_API_KEY=your-fast2sms-key
# Country code used to build Twilio's E.164 destination (default 91)
# SMS_COUNTRY_CODE=91
# Firebase Auth (client SDK owns the challenge)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Institutional contact (shown in footer)
NEXT_PUBLIC_CONTACT_EMAIL=Samyakthora@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+91 9098088466
NEXT_PUBLIC_INSTITUTE=Medi-Caps University | Cause '26

# ------------------------------------------------------------------
# Site URL — canonical origin used by src/app/robots.ts and src/app/sitemap.ts
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hostel-hub-9py0.onrender.com